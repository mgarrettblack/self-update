# Example config for cmd/app, loaded with `-env <path>` (default: this file,
# resolved relative to the working directory the demo is run from).

# Full URL of the signed release manifest. Required.
manifest_url=http://127.0.0.1:8099/manifest.json

# Executable to replace. Leave empty to replace the running executable.
target=/tmp/install/demoapp

# Directory for the lock, install id and rollback marker. Leave empty for
# the platform default state directory.
state_dir=/tmp/st

# Base interval between update checks, before jitter.
interval=1h
